<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.juaneuse.sniffx.controller.SnifferController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
         <menus>
            <Menu mnemonicParsing="false" text="File">
               <items>
                  <MenuItem mnemonicParsing="false" text="New" />
                  <MenuItem mnemonicParsing="false" text="Open…" />
                  <Menu mnemonicParsing="false" text="Open Recent" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" text="Close" />
                  <MenuItem mnemonicParsing="false" text="Save" />
                  <MenuItem mnemonicParsing="false" text="Save As…" />
                  <MenuItem mnemonicParsing="false" text="Revert" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" text="Preferences…" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" text="Quit" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Help">
               <items>
                  <MenuItem mnemonicParsing="false" text="About SniffX" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
   </top>
   <center>
      <SplitPane fx:id="splitPane" dividerPositions="1.0" orientation="VERTICAL" prefHeight="351.0" prefWidth="640.0" BorderPane.alignment="CENTER">
         <items>
            <AnchorPane fx:id="panelSuperior" minHeight="0.0" minWidth="0.0" prefHeight="165.0" prefWidth="400.0">
               <children>
                  <BorderPane prefHeight="165.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <center>
                        <TableView fx:id="tablePackets" fixedCellSize="24.0" prefHeight="165.0" prefWidth="579.0" BorderPane.alignment="CENTER">
                           <columns>
                              <TableColumn fx:id="columnTimestamp" editable="false" prefWidth="75.0" text="Timestamp" />
                              <TableColumn fx:id="columnLegth" editable="false" prefWidth="75.0" text="Length" />
                              <TableColumn fx:id="columnProtocol" editable="false" prefWidth="75.0" text="Protocol" />
                              <TableColumn fx:id="ColumnDest" editable="false" prefWidth="75.0" text="Destination" />
                              <TableColumn fx:id="ColumnSour" editable="false" prefWidth="75.0" text="Source" />
                           </columns>
                           <BorderPane.margin>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </BorderPane.margin>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </center>
                     <top>
                        <VBox alignment="CENTER" prefHeight="64.0" prefWidth="598.0" BorderPane.alignment="CENTER">
                           <children>
                              <HBox prefHeight="27.0" prefWidth="600.0" spacing="5.0">
                                 <children>
                                    <ToggleButton fx:id="btnStatus" mnemonicParsing="false" onAction="#onTracked" text="Iniciar" />
                                    <ComboBox fx:id="comboInterfaces" onAction="#onInterfaceSelected" prefWidth="150.0" promptText="Interfaz de red" />
                                 </children>
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                              </HBox>
                              <HBox prefHeight="22.0" prefWidth="598.0" spacing="5.0">
                                 <children>
                                    <TextField fx:id="textFilterBpf" maxWidth="1.7976931348623157E308" onAction="#aplicarFiltro" prefHeight="26.0" prefWidth="581.0" promptText="Filtro avanzado" HBox.hgrow="ALWAYS">
                                       <HBox.margin>
                                          <Insets />
                                       </HBox.margin>
                                    </TextField>
                                    <Button mnemonicParsing="false" onAction="#cleanFilter" text="X" textFill="#da1313">
                                       <font>
                                          <Font name="System Bold" size="13.0" />
                                       </font>
                                    </Button>
                                 </children>
                                 <padding>
                                    <Insets left="10.0" right="10.0" />
                                 </padding>
                              </HBox>
                           </children>
                           <BorderPane.margin>
                              <Insets />
                           </BorderPane.margin>
                        </VBox>
                     </top>
                  </BorderPane>
               </children>
            </AnchorPane>
            <AnchorPane fx:id="panelInferior" minHeight="0.0" minWidth="0.0" prefHeight="100.0" prefWidth="200.0">
   <children>
      <GridPane fx:id="gridInfoPacket" hgap="10.0" prefHeight="129.0" prefWidth="598.0" vgap="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
                     <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
      </GridPane>
   </children>
</AnchorPane>

         </items>
      </SplitPane>
   </center>
   <bottom>
      <ToolBar prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <items>
            <Button fx:id="btnPaneInfo" mnemonicParsing="false" onAction="#onView" text="Info" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="labelQueueStatus" text="Estado de cola: normal" textFill="#2e7d32" />
         </items>
      </ToolBar>
   </bottom>
</BorderPane>
